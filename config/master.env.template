# Master configuration template for the Smart Employee demo.
# This file is safe to commit because all sensitive values are blank placeholders.
# Runtime file: config/master.env (generated locally, do not commit).

# ---- Core endpoints ----
MASTER_WSO2_IS_BASE_URL_HOST=https://localhost:9443
MASTER_WSO2_IS_BASE_URL_SERVICE=https://wso2is:9443
MASTER_ORCHESTRATOR_PUBLIC_URL=http://localhost:8090
MASTER_ALLOWED_ORIGINS=http://localhost:8090,http://127.0.0.1:8090
MASTER_IDP_INSECURE_TLS=1

# ---- Bootstrap-generated OAuth and Agent values ----
ORCHESTRATOR_MCP_CLIENT_ID=
ORCHESTRATOR_MCP_CLIENT_SECRET=
ORCHESTRATOR_MCP_CLIENT_REDIRECT_URI=http://localhost:8090/agent-callback
POST_LOGOUT_REDIRECT_URI=http://localhost:8090/

ORCHESTRATOR_AGENT_ID=
ORCHESTRATOR_AGENT_SECRET=
ORCHESTRATOR_AGENT_OAUTH_CLIENT_ID=
ORCHESTRATOR_AGENT_OAUTH_CLIENT_SECRET=

HR_AGENT_ID=
HR_AGENT_SECRET=
HR_AGENT_OAUTH_CLIENT_ID=
HR_AGENT_OAUTH_CLIENT_SECRET=
HR_AGENT_REDIRECT_URI=http://localhost:9999/agent-callback

IT_AGENT_ID=
IT_AGENT_SECRET=
IT_AGENT_OAUTH_CLIENT_ID=
IT_AGENT_OAUTH_CLIENT_SECRET=
IT_AGENT_REDIRECT_URI=http://localhost:9999/agent-callback


# ---- Derived trust and audience wiring ----
TRUSTED_SPECIALIST_SUBS=
HR_EXPECTED_INBOUND_AUD=
IT_EXPECTED_INBOUND_AUD=
HR_SERVER_EXPECTED_AUD=
IT_SERVER_EXPECTED_AUD=

# ---- Feature flags ----
# UAEPass federated login + branding. false (default) = stock WSO2 IS login,
# local Basic auth, no branding; true = "Sign in with UAEPass" + UAE PASS
# branding. Drives both the IS bootstrap and the SPA sign-in page.
ENABLE_UAEPASS=false

# ---- External integrations (fill on first run) ----
LLM_FALLBACK_MODE=keyword
OPENAI_BASE_URL=
OPENAI_API_HEADER=api-key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
AMP_OTEL_ENDPOINT=https://opentelemetry.obs.dp.cloud.wso2.com/v1/traces
AMP_AGENT_API_KEY=
INTERNAL_REVOKE_SHARED_SECRET=
