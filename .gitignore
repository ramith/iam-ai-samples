# ============================================================================
# srt-emp — Smart Employee Agent demo (.gitignore)
# ============================================================================

# ── Secrets & environment (NEVER commit) ───────────────────────────────────
# Per-service runtime env files (rendered from master / templates). The
# committed *.env.example templates carry safe defaults.
**/.env
/.env
config/master.env
# Test/probe credential files
scripts/probes/.test-users.env
idp_capability_test/.substrate.env
# Keys & certs — leaking IS signing keys = full IdP compromise
*.pem
*.p12
*.jks
wso2_private*

# ── Dev-only / local overrides ─────────────────────────────────────────────
# NOTE: docker-compose.override.yml IS committed — it's the standard dev setup
# (source mounts + uvicorn --reload + per-service ENABLE_API_TRACES). No secrets.
_local/
tempz/
/.vm-tunnel.pid
data.txt
.vscode/
platform/

# ── WSO2 IS pack zip (legacy; image now pulled from Docker Hub) ─────────────
# The IS server is no longer built from a local zip — wso2-is/Dockerfile bases
# off the official wso2/wso2is:<version>-alpine image. Keep ignoring any stray
# pack zip so an old/downloaded copy can never be committed by accident.
**/wso2is-*.zip
# NOTE: the small connector JAR, logo, error JSP (wso2-is/uaepass/), the
# entrypoint (wso2-is/entrypoint/), and the default login-page assets
# (wso2-is/default/ — smart-employee-logo.jpeg + sample-payload.json branding
# base) ARE committed — they're the build inputs.

# ── Runtime cruft / logs / markers ─────────────────────────────────────────
*.log
is_server_logs/*.log
*.lck
.bootstrap/
hs_err_pid*
replay_pid*
tools/_bcl_log/*.log

# ── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
**/.venv/
**/venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Node / frontend (SPA tooling, if used) ─────────────────────────────────
node_modules/
**/node_modules/
dist/
build/
out/
.cache/
.parcel-cache/
*.tsbuildinfo
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS / IDE ───────────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store
.idea/
*.iml
wso2-is/default/sample-payload.json
